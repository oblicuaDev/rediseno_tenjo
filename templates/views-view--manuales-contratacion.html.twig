{#
  Plantilla: Contenedor Principal Vista MANUALES DE CONTRATACIÓN Y COMPRAS
  Archivo: views-view--manuales-contratacion.html.twig
#}
<style>
  body, html { overflow-x: hidden; }
  .accordion-content { display: none; }
  .accordion-header .accordion-chevron { transition: transform 0.3s ease; }
  .accordion-header.activo .accordion-chevron { transform: rotate(180deg); }
</style>

<div class="pagina-estatica-manuales-contratacion">

  {# --- 1. HERO INSTITUCIONAL --- #}
  <div class="page-hero" style="margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); width: 100vw; max-width: 100vw; background-color: var(--verde-medio, #1a3c28); padding: 60px 0; color: #ffffff;">
    <div class="container page-hero-inner" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">

      <div class="page-hero-breadcrumb" style="margin-bottom: 20px; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.7);">
        <a href="/es" style="color: #fff; text-decoration: none;">INICIO</a>
        <span class="sep">></span>
        <a href="/transparencia" style="color: #fff; text-decoration: none;">TRANSPARENCIA</a>
        <span class="sep">></span>
        <span>MANUALES DE CONTRATACIÓN Y COMPRAS</span>
      </div>

      <h1 style="color: #fff; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 800; line-height: 1.15; margin: 0;">
        Manuales de Contratación <br>
        <span style="color: var(--acento, #D4A843);">y Compras</span>
      </h1>

    </div>
  </div>

  {# --- 2. CONTENIDO PRINCIPAL --- #}
  <div class="container" style="max-width: 1100px; margin: 50px auto 100px auto; padding: 0 20px;">

    {# --- 3. ACORDEONES DINÁMICOS DE LA VISTA --- #}
    <h2 style="font-size: 1.8rem; color: var(--verde-oscuro, #1a3c28); font-weight: 800; margin: 0 0 25px 0; text-align: center; border-bottom: 2px solid #EBE9E0; padding-bottom: 10px;">
      Manuales por Año
    </h2>

        {% set documentos = [] %}
    {% for resultado in view.result %}
      {% set nodo = resultado._entity %}
      {% set es_contratacion = false %}
      {% for categoria in nodo.field_categoria_del_documento %}
        {% if categoria.entity.label|lower == 'manuales de contratación' %}
          {% set es_contratacion = true %}
        {% endif %}
      {% endfor %}
      {% if es_contratacion %}
        {% set fecha = nodo.field_fecha_documento.value ?: nodo.created.value %}
        {% set documentos = documentos|merge([{
          content: {
            '#theme': 'views_view_fields',
            '#view': view,
            '#row': resultado
          },
          fecha: fecha|date('U'),
          creado: nodo.created.value,
          anio: fecha|date('Y')
        }]) %}
      {% endif %}
    {% endfor %}
    {% set documentos = documentos|sort((a, b) => (b.fecha <=> a.fecha) ?: (b.creado <=> a.creado)) %}
    {% set anios = {} %}
    {% for documento in documentos %}
      {% set clave_anio = 'anio-' ~ documento.anio %}
      {% set anios = anios|merge({ (clave_anio): anios[clave_anio]|default([])|merge([documento]) }) %}
    {% endfor %}
    {% for documentos_anio in anios %}
      {% include 'views-view-unformatted--manuales-contratacion.html.twig' with {
        rows: documentos_anio,
        title: (documentos_anio|first).anio
      } %}
    {% endfor %}

    {% if not documentos %}
      <div style="text-align: center; padding: 40px; color: #666; border: 1px dashed #ccc; border-radius: 12px;">
        <p>No hay documentos de Manuales de Contratación y Compras publicados actualmente.</p>
      </div>
    {% endif %}

  </div>
</div>

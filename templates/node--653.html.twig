    {# Imagen (desde el cuerpo del nodo) #}
    <div class="imagen-programa-primera-infancia" style="text-align: center; margin-bottom: 40px;">
      <style>
        .pagina-programas-primera-infancia .field--name-body img,
        .pagina-programas-primera-infancia .text-formatted img,
        .imagen-programa-primera-infancia img {
          max-width: 100% !important;
          height: auto !important;
          width: auto !important;
          object-fit: contain !important;

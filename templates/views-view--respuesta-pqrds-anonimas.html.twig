{#
  Plantilla: Contenedor de la Vista de PQRDS
  Archivo: views-view--respuesta-pqrds-anonimas.html.twig
#}
<style>
  body, html { overflow-x: hidden; }
  .accordion-content { display: none; }
  .accordion-header .accordion-chevron { transition: transform 0.3s ease; }
  .accordion-header.activo .accordion-chevron { transform: rotate(180deg); }
</style>

<div class="pagina-estatica-pqrs">

  {# --- 1. HERO INSTITUCIONAL --- #}
  <div class="page-hero" style="margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); width: 100vw; max-width: 100vw; background-color: var(--verde-medio, #1a3c28); padding: 60px 0; color: #ffffff;">
    <div class="container page-hero-inner" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">

      <div class="page-hero-breadcrumb" style="margin-bottom: 20px; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.7);">
        <a href="/es" style="color: #fff; text-decoration: none;">INICIO</a>
        <span class="sep">></span>
        <a href="/transparencia" style="color: #fff; text-decoration: none;">TRANSPARENCIA</a>
        <span class="sep">></span>
        <span>PQRS</span>
      </div>

      <h1 style="color: #fff; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 800; line-height: 1.15; margin: 0;">
        Respuestas a
        <span style="color: var(--acento, #D4A843);">PQRDS Anónimas</span>
      </h1>

    </div>
  </div>

  {# --- 2. CONTENIDO PRINCIPAL --- #}
  <div class="container" style="max-width: 1100px; margin: 60px auto 100px auto; padding: 0 20px;">

    {# Texto Introductorio #}
    <div style="background-color: #F8F9F3; border-radius: 12px; padding: 30px; border: 1px solid #EBE9E0; margin-bottom: 40px;">
      <p style="font-size: 1.1rem; line-height: 1.6; color: #444; margin: 0;">
        El Instituto Municipal de Cultura y Turismo de Tenjo da a conocer a la comunidad las respuestas a las PQRS que se reciben de manera anónima, acorde a la Ley 1712 de 2014 de Transparencia y Acceso a la Información.
      </p>
    </div>

    {# --- Canales de atención y horarios (idéntico al pie de página institucional) --- #}
    <div style="background-color: #FCFAEF; border: 1px solid #EBE9E0; border-left: 4px solid var(--verde-oscuro, #1a3c28); border-radius: 12px; padding: 30px; margin-bottom: 40px;">

      <div style="display: flex; flex-wrap: wrap; gap: 32px;">

        <div style="flex: 1; min-width: 260px;">
          <p style="font-weight: 800; color: var(--verde-oscuro, #1a3c28); font-size: 1rem; margin: 0 0 6px 0;">Ubicación</p>
          <p style="color: #555; font-size: 0.95rem; line-height: 1.6; margin: 0;">
            Centro Cultural Nhora Matallana<br>
            Km 1, Vía La Punta, Tenjo<br>
            Cundinamarca, Colombia
          </p>
        </div>

        <div style="flex: 1; min-width: 260px;">
          <p style="font-weight: 800; color: var(--verde-oscuro, #1a3c28); font-size: 1rem; margin: 0 0 6px 0;">Horarios de atención administrativa</p>
          <p style="color: #555; font-size: 0.95rem; line-height: 1.6; margin: 0 0 16px 0;">
            Lunes a viernes de 8:00 a.m. a 1:00 p.m. y 2:00 p.m. a 5:00 p.m.<br>
            Sábados de 8:00 a.m. a 12:00 p.m.
          </p>
          <p style="font-weight: 800; color: var(--verde-oscuro, #1a3c28); font-size: 1rem; margin: 0 0 6px 0;">Horario escuela de formación artística y cultural</p>
          <p style="color: #555; font-size: 0.95rem; line-height: 1.6; margin: 0;">
            Lunes a viernes de 8:00 a.m. a 1:00 p.m. y 2:00 p.m. a 8:00 p.m.
            Sábados de 8:00 a.m. a 12:00 p.m.
          </p>
        </div>

      </div>

      <div style="margin-top: 24px; padding-top: 24px; border-top: 1px solid #EBE9E0;">
        <a href="https://tenjoculturayturismo.gov.co/apps/pqr_imctt/" target="_blank" rel="noopener noreferrer"
           style="display: inline-flex; align-items: center; gap: 8px; background: var(--verde-oscuro, #1a3c28); color: #fff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; font-size: 0.95rem;"
           aria-label="Ir a la Plataforma de PQRSDF (abre en nueva ventana)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Plataforma de PQRSDF
        </a>
      </div>

    </div>

    {# Título de sección #}
    <h2 style="font-size: 1.8rem; color: var(--verde-oscuro, #1a3c28); font-weight: 800; margin: 0 0 25px 0; text-align: center; border-bottom: 2px solid #EBE9E0; padding-bottom: 10px;">
      Respuestas por Año
    </h2>

    {# Aquí se imprimirán los acordeones agrupados por año #}
    {{ rows }}

    {# Mensaje si no hay PQRS cargadas #}
    {% if not rows %}
      <div style="text-align: center; padding: 40px; color: #666; border: 1px dashed #ccc; border-radius: 12px;">
        <p style="font-size: 1.2rem;">No hay respuestas a PQRDS para mostrar en este momento.</p>
      </div>
    {% endif %}

  </div>
</div>
